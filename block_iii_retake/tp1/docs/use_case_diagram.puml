@startuml
left to right direction
skinparam monochrome true
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam dpi 150
skinparam packageStyle rectangle
skinparam usecaseBackgroundColor white
skinparam actorBackgroundColor white
skinparam legendBackgroundColor white
skinparam legendBorderColor black

actor "Recepcionista" as reception
actor "Veterinário" as vet

rectangle "Clínica VidaPet" {
  usecase "Cadastrar Animal" as UC01
  usecase "Cadastrar Veterinário" as UC02
  usecase "Agendar Consulta" as UC03
  usecase "Verificar Disponibilidade\ndo Veterinário" as UC04
  usecase "Cancelar Consulta" as UC05
  usecase "Consultar Agenda do Dia" as UC06
  usecase "Registrar Atendimento" as UC07
}

reception -- UC01
reception -- UC02
reception -- UC03
reception -- UC05
UC06 -- vet
UC07 -- vet
UC04 -[hidden]- vet

UC03 ..> UC04 : <<include>>

legend bottom
  UC → RF
  UC01 → RF01, RF02
  UC02 → RF03
  UC03 → RF04, RF05, RF06, RF08
  UC04 → RF07
  UC05 → RF09, RF10
  UC06 → RF11
  UC07 → RF12, RF13, RF14
endlegend
@enduml
